# ==============================================================================
# ClaimPilot AI - Orchestrator & Decision Engine Configuration
# ==============================================================================

# Connected Microservices URLs
DOCUMENT_AGENT_URL=http://localhost:8001
IMAGE_AGENT_URL=http://localhost:8002
COST_AGENT_URL=http://localhost:8080/api/cost/estimate

# Fallback Mode: Enables local cost estimation if Pratik's Spring AI endpoint is offline
COST_AGENT_MOCK_FALLBACK=true

# Statutory & Adjudication Rules (IRDAI Limit)
IRDAI_MAX_AUTO_APPROVAL_LIMIT=50000.0

# Service & Logging Settings
SERVICE_NAME="ClaimPilot Orchestrator & Decision Engine"
SERVICE_VERSION="1.0.0"
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=35.0
