# ==============================================================================
# ClaimPilot AI - Image/Damage Assessment Agent Environment Configuration
# ==============================================================================

# Mode: true for instant mock test, false for live vision
MOCK_MODE=false

# Service metadata
SERVICE_NAME="ClaimPilot Image Damage Assessment Agent"
SERVICE_VERSION="1.0.0"
LOG_LEVEL=INFO

# Constraints
MAX_FILE_SIZE_MB=10
MAX_IMAGE_COUNT=8
REQUEST_TIMEOUT_SECONDS=30.0

# Detection Engine: "custom" (Default) or "gemini"
DETECTION_ENGINE=custom
CUSTOM_MODEL_PATH=models/damage_yolo.onnx

# Pure Google Gemini Configuration (Used as Fallback)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
