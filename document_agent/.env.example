# ==============================================================================
# ClaimPilot AI - Production Document Verification Agent Configuration
# ==============================================================================

# Mode: Production-first (MOCK_MODE=false runs live multimodal vision)
MOCK_MODE=false

# Service metadata
SERVICE_NAME="ClaimPilot Document Verification Agent"
SERVICE_VERSION="2.0.0"
LOG_LEVEL=INFO

# File Upload & Pre-check Constraints
MAX_FILE_SIZE_MB=10
MIN_IMAGE_DIMENSION_PX=200
REQUEST_TIMEOUT_SECONDS=25.0

# Multimodal Vision Provider: "gemini" (Default) or "openai"
VISION_PROVIDER=gemini

# Google Gemini Configuration (Fast, high-accuracy multimodal)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Configuration (Alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini

# Tiered Selective LLM Fallback (Triggered only on low-confidence fields < 0.85)
OCR_CONFIDENCE_FALLBACK_THRESHOLD=0.85

# Matching Thresholds (Deterministic rapidfuzz)
FUZZY_EXACT_THRESHOLD=98.0
FUZZY_MATCH_THRESHOLD=80.0
FUZZY_CROSS_DOC_SUSPICIOUS_THRESHOLD=65.0
